{
  "name": "workshape",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "account": "node --env-file-if-exists=.env --import tsx scripts/account.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "mcp:stdio": "node --env-file-if-exists=.env scripts/mcp-stdio.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.125",
    "@modelcontextprotocol/server": "^2.4.0",
    "@xyflow/react": "^13.0.3",
    "ai": "^7.0.183",
    "jose": "^6.2.18",
    "mcp-handler": "^2.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
